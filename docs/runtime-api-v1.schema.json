{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mashengran2001-prog/codex-cli-ui/docs/runtime-api-v1.schema.json",
  "title": "Codex CLI UI Runtime API v1 frames",
  "description": "Authenticated JSON Lines requests and responses for the local Codex CLI UI runtime control plane.",
  "type": "object",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "required": [
        "id",
        "token",
        "method",
        "params"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "token": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "enum": [
            "runtime.describe",
            "runtime.snapshot",
            "runtime.orchestrate",
            "window.create",
            "window.focus",
            "tab.new",
            "pane.focus",
            "pane.read",
            "pane.prompt",
            "pane.run",
            "pane.split",
            "pane.procs",
            "pane.send_key",
            "pane.wait",
            "events.pane_lifecycle",
            "events.subscribe",
            "agents.list",
            "agent.get",
            "agent.start",
            "agent.fork",
            "agent.prompt",
            "agent.read",
            "agent.wait"
          ]
        },
        "params": {
          "type": "object"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "method": {
                "const": "runtime.describe"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "runtime.snapshot"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "runtime.orchestrate"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "steps"
                ],
                "properties": {
                  "steps": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 32,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "id",
                        "op"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[_a-zA-Z][_a-zA-Z0-9-]{0,63}$"
                        },
                        "op": {
                          "enum": [
                            "new_tab",
                            "focus",
                            "split",
                            "prompt",
                            "run",
                            "agent_launch"
                          ]
                        },
                        "window_id": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "cwd": {
                          "type": "string"
                        },
                        "target": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "pane_id": {
                              "type": "string",
                              "minLength": 1
                            },
                            "window_id": {
                              "type": "integer",
                              "minimum": 1
                            },
                            "step": {
                              "type": "string",
                              "minLength": 1
                            },
                            "field": {
                              "const": "pane_id"
                            }
                          },
                          "anyOf": [
                            {
                              "required": [
                                "pane_id"
                              ]
                            },
                            {
                              "required": [
                                "step",
                                "field"
                              ]
                            }
                          ]
                        },
                        "direction": {
                          "enum": [
                            "columns",
                            "rows"
                          ]
                        },
                        "text": {
                          "type": "string",
                          "minLength": 1
                        },
                        "submit": {
                          "type": "boolean"
                        },
                        "command": {
                          "type": "string",
                          "minLength": 1
                        },
                        "wait": {
                          "type": "boolean"
                        },
                        "timeout_ms": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 86400000
                        },
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64
                        },
                        "kind": {
                          "type": "string",
                          "enum": [
                            "claude",
                            "codex",
                            "gemini",
                            "opencode",
                            "amp",
                            "cursor",
                            "copilot",
                            "grok",
                            "pi",
                            "omp"
                          ]
                        },
                        "resume_session_id": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9._-]{1,64}$"
                        },
                        "initial_prompt": {
                          "type": "string",
                          "minLength": 1
                        },
                        "ready_timeout_ms": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 86400000
                        }
                      }
                    }
                  },
                  "on_error": {
                    "enum": [
                      "stop",
                      "continue"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "window.create"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "window.focus"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "window_id": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "pane_id": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "tab.new"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "cwd": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "pane.focus"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "pane_id"
                ],
                "properties": {
                  "pane_id": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "pane.read"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "pane_id"
                ],
                "properties": {
                  "pane_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "lines": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5000
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "pane.prompt"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "pane_id",
                  "text"
                ],
                "properties": {
                  "pane_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "submit": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "pane.run"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "pane_id",
                  "command"
                ],
                "properties": {
                  "pane_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "command": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "wait": {
                    "type": "boolean"
                  },
                  "timeout_ms": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 86400000
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "pane.split"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "pane_id",
                  "direction"
                ],
                "properties": {
                  "pane_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "direction": {
                    "enum": [
                      "columns",
                      "rows"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "pane.procs"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "pane_id"
                ],
                "properties": {
                  "pane_id": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "pane.send_key"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "pane_id",
                  "key"
                ],
                "properties": {
                  "pane_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "key": {
                    "type": "string",
                    "enum": [
                      "escape",
                      "enter",
                      "tab",
                      "backspace",
                      "up",
                      "down",
                      "left",
                      "right",
                      "home",
                      "end",
                      "insert",
                      "delete",
                      "page_up",
                      "page_down",
                      "f1",
                      "f2",
                      "f3",
                      "f4",
                      "f5",
                      "f6",
                      "f7",
                      "f8",
                      "f9",
                      "f10",
                      "f11",
                      "f12",
                      "a",
                      "b",
                      "c",
                      "d",
                      "e",
                      "f",
                      "g",
                      "h",
                      "i",
                      "j",
                      "k",
                      "l",
                      "m",
                      "n",
                      "o",
                      "p",
                      "q",
                      "r",
                      "s",
                      "t",
                      "u",
                      "v",
                      "w",
                      "x",
                      "y",
                      "z"
                    ]
                  },
                  "modifiers": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "shift": {
                        "type": "boolean"
                      },
                      "alt": {
                        "type": "boolean"
                      },
                      "control": {
                        "type": "boolean"
                      }
                    }
                  },
                  "repeat": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 64
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "pane.wait"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "pane_id",
                  "state"
                ],
                "properties": {
                  "pane_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "state": {
                    "enum": [
                      "idle",
                      "running",
                      "waiting_input",
                      "attention",
                      "finished",
                      "failed",
                      "settled"
                    ]
                  },
                  "timeout_ms": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 86400000
                  },
                  "after_seq": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "events.pane_lifecycle"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "since_seq": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "events.subscribe"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "since_seq": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "timeout_ms": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 86400000
                  },
                  "since_revision": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "agents.list"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "window_id": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "agent.get"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "agent"
                ],
                "properties": {
                  "agent": {
                    "type": "string",
                    "minLength": 1
                  },
                  "generation": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "agent.start"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "kind"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "claude",
                      "codex",
                      "gemini",
                      "opencode",
                      "amp",
                      "cursor",
                      "copilot",
                      "grok",
                      "pi",
                      "omp"
                    ]
                  },
                  "cwd": {
                    "type": "string"
                  },
                  "pane_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "resume_session_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9._-]{1,64}$"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "agent.fork"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "kind"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "claude",
                      "codex",
                      "gemini",
                      "opencode",
                      "amp",
                      "cursor",
                      "copilot",
                      "grok",
                      "pi",
                      "omp"
                    ]
                  },
                  "source_pane": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source_cwd": {
                    "type": "string"
                  },
                  "resume_session_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9._-]{1,64}$"
                  },
                  "branch": {
                    "type": "string"
                  },
                  "base": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "allow_dirty_source": {
                    "type": "boolean"
                  }
                },
                "anyOf": [
                  {
                    "required": [
                      "source_pane"
                    ]
                  },
                  {
                    "required": [
                      "source_cwd"
                    ]
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "agent.prompt"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "agent",
                  "text"
                ],
                "properties": {
                  "agent": {
                    "type": "string",
                    "minLength": 1
                  },
                  "generation": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "submit": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "agent.read"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "agent"
                ],
                "properties": {
                  "agent": {
                    "type": "string",
                    "minLength": 1
                  },
                  "generation": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "lines": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2000
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "agent.wait"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "agent",
                  "generation",
                  "state"
                ],
                "properties": {
                  "agent": {
                    "type": "string",
                    "minLength": 1
                  },
                  "generation": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "state": {
                    "enum": [
                      "idle",
                      "running",
                      "waiting_input",
                      "attention",
                      "finished",
                      "failed",
                      "settled"
                    ]
                  },
                  "timeout_ms": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 86400000
                  },
                  "after_seq": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        }
      ]
    },
    "response": {
      "type": "object",
      "required": [
        "id",
        "ok"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "ok": {
          "type": "boolean"
        },
        "result": {},
        "error": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "details": {}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
