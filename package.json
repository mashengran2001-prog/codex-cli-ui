{
  "name": "codex-cli-ui",
  "version": "0.2.0",
  "private": true,
  "description": "A local-first desktop UI for Codex CLI",
  "author": "mashengran2001-prog",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mashengran2001-prog/codex-cli-ui.git"
  },
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 4321 --strictPort\" \"wait-on tcp:4321 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:4321 electron .\"",
    "build": "tsc -p tsconfig.electron.json && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "npm run typecheck && npm run build && node tests/terminal-utils.mjs && node tests/text-encoding.mjs && node tests/terminal-math.mjs && node tests/update-manager.mjs && node tests/font-import.mjs && node tests/encrypted-backup.mjs && node tests/system-fonts.mjs && node tests/vcs.mjs && node tests/cli-lifecycle.mjs && node tests/claude-provider-sessions.mjs && node tests/runtime-artifacts.mjs && npm run test:shell-startup && node tests/git-worktree.mjs && node tests/workflow.mjs && node tests/electron-workflow.mjs && node tests/visual-smoke.mjs && node tests/electron-visual.mjs && npm run test:launcher",
    "test:workflow": "npm run build && node tests/workflow.mjs && node tests/electron-workflow.mjs",
    "test:visual": "npm run build && node tests/visual-smoke.mjs && node tests/electron-visual.mjs",
    "test:launcher": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/launcher.ps1",
    "test:shell-startup": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/shell-startup.ps1",
    "launch": "npm run build && electron .",
    "install:launcher": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-launcher.ps1 -Action Install",
    "uninstall:launcher": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-launcher.ps1 -Action Uninstall",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@deepseek-ai/dsh-agent-spine-demo": "0.1.0-rc.7",
    "@deepseek-ai/dsh-bash-local": "0.1.0-rc.7",
    "@deepseek-ai/dsh-fs-local": "0.1.0-rc.7",
    "@deepseek-ai/dsh-fs-observation-policy": "0.1.0-rc.7",
    "@deepseek-ai/dsh-llm-deepseek": "0.1.0-rc.7",
    "@deepseek-ai/dsh-pwsh-local": "0.1.0-rc.7",
    "@deepseek-ai/dsh-sdk-client": "0.1.0-rc.7",
    "@deepseek-ai/dsh-sdk-jsonrpc-demo": "0.1.0-rc.7",
    "@deepseek-ai/dsh-sdk-jsonrpc-server": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session-checkpoint-policy": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.1.0-rc.7",
    "@deepseek-ai/dsh-shell-env": "0.1.0-rc.7",
    "@deepseek-ai/dsh-subprocess-local": "0.1.0-rc.7",
    "@deepseek-ai/dsh-tool-bash": "0.1.0-rc.7",
    "@deepseek-ai/dsh-tool-fs": "0.1.0-rc.7",
    "@deepseek-ai/dsh-tool-pwsh": "0.1.0-rc.7",
    "@lobehub/icons-static-svg": "^1.94.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-image": "^0.9.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "katex": "^0.18.4",
    "lucide-react": "^0.468.0",
    "node-pty": "^1.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.3",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "toml-eslint-parser": "^0.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "playwright": "^1.49.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.local.codexcliui",
    "productName": "Codex CLI UI",
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts",
        "filter": [
          "*.ps1",
          "*.yml",
          "*.mjs"
        ]
      },
      {
        "from": "docs/runtime-api-v1.schema.json",
        "to": "runtime/runtime-api-v1.schema.json"
      },
      {
        "from": "docs/runtime-control-api.md",
        "to": "runtime/runtime-control-api.md"
      },
      {
        "from": "docs/skills/nebula-runtime",
        "to": "skills/nebula-runtime"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "${productName} Portable ${version}.${ext}"
    }
  }
}
