{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "outDir": "dist-electron",
    "rootDir": ".",
    "sourceMap": true
  },
  "include": [
    "electron/**/*.ts",
    "src/types.ts",
    "src/terminal/terminal-math.ts",
    "src/terminal/box-glyphs.ts"
  ]
}
